{
  "name": "espresso",
  "version": "2.3.0",
  "description": "Concise output, same-model delegation and bundled Ponytail enabled by default.",
  "author": {"name": "Mirko Bozzetto", "url": "https://github.com/mirkobozzetto"},
  "skills": "./skills",
  "hooks": {
    "SessionStart": [{"hooks":[{"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/ponytail.js\" SessionStart","timeout":5}]}],
    "UserPromptSubmit": [{"hooks":[{"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/espresso-remind.js\"","timeout":5},{"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/ponytail.js\" UserPromptSubmit","timeout":5}]}],
    "SubagentStart": [{"hooks":[{"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/ponytail.js\" SubagentStart","timeout":5}]}]
  }
}
